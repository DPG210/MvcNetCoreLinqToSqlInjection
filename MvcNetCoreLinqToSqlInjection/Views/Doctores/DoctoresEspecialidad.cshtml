@model List<Doctor>

<h1>Doctores Especialidad</h1>

@if (Model != null)
{
    <form method="post">
        <label>Especialidad</label>
        <input type="text" name="especialidad" />
        <button>Buscar</button>
    </form>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>IdDoctor</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Salario</th>
                <th>Hospital</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Doctor doc in Model)
            {
                <tr>
                    <td>@doc.IdDoctor</td>
                    <td>@doc.Apellido</td>
                    <td>@doc.Especialidad</td>
                    <td>@doc.Salario</td>
                    <td>@doc.IdHospital</td>
                    
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Doctores" asp-action="Create" class="brn btn-link">Go to Create</a>