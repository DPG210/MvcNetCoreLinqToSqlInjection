@model List<Doctor>

    <h1>Doctores SQL SERVER y Oracle DI</h1>

@if(Model != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>IdDoctor</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Salario</th>
                <th>Hospital</th>
            </tr>
        </thead>
        <tbody>
            @foreach(Doctor doc in Model)
            {
                <tr>
                    <td>@doc.IdDoctor</td>
                    <td>@doc.Apellido</td>
                    <td>@doc.Especialidad</td>
                    <td>@doc.Salario</td>
                    <td>@doc.IdHospital</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Doctores" asp-action="Create" class="brn btn-link">Go to Create</a>